DATABASE_URL=postgres://agentmap:agentmap@localhost:5432/agentmap
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
MCP_PORT=8080
MCP_PUBLIC_URL=http://localhost:8080
MCP_ALLOWED_ORIGINS=http://localhost:3000
ADMIN_TOKEN=
API_KEY_PEPPER=change-me
INDEXER_CONCURRENCY=4
INDEXER_PER_DOMAIN_CONCURRENCY=1
CRAWL_MAX_PAGES=2000
CRAWL_MAX_DEPTH=6
VERIFIER_FETCH_TIMEOUT_MS=8000
VERIFIER_CACHE_TTL_S=30
OFFERS_ENABLED=false
OFFERS_PROVIDER=none
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
MATCHING_CACHE_ACCEPT=0.86
MATCHING_NODE_FLOOR=0.55
MATCHING_ABSTAIN_THRESHOLD=0.45
MATCHING_MAX_HOPS=6
INDEX_DEMAND_DISTINCT_AGENTS=5
INDEX_DEMAND_SIGNALS_7D=20

# Optional: OpenAI-compatible endpoint (e.g. Fireworks: https://api.fireworks.ai/inference/v1) and requested output dims (must equal the DB vector size, 1536)
EMBEDDING_BASE_URL=
EMBEDDING_DIMS=
# Zero-pad shorter model vectors (e.g. 768-d nomic) up to the DB column size; cosine is unchanged
EMBEDDING_PAD_TO=

# Self-hosted embeddings via Ollama (free): `ollama pull nomic-embed-text`, then
#   EMBEDDING_PROVIDER=openai  EMBEDDING_BASE_URL=http://localhost:11434/v1  EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_API_KEY=ollama   EMBEDDING_PAD_TO=1536  MATCHING_NODE_FLOOR=0.45  MATCHING_ABSTAIN_THRESHOLD=0.35
# Then re-embed existing rows: node apps/mcp-server/dist/cli.js reembed
