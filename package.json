    "test:cov": "vitest run --coverage",
    "lint": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
